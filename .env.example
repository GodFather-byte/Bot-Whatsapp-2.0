# WhatsApp
# Seu número do WhatsApp (com DDI e DDD): o Bot PH Zeus se conecta a ele e responde por você quando você está offline
NUMEROS_BOT=5511999999999
# Seu nome, para o assistente falar de você ("assistente pessoal de ...")
NOME_DONO=
# Minutos sem você enviar mensagens para contar como ausente (modo auto)
AUSENTE_APOS_MIN=10
# Minutos em que o assistente se cala numa conversa depois que você responde nela
SILENCIAR_APOS_RESPOSTA_MIN=60
# false desliga o aviso na conversa "Você" quando o assistente atende uma conversa nova
AVISAR_DONO=true
# Deixe comentada para o assistente responder qualquer contato. Atenção: se a variável
# existir (mesmo vazia), só os números listados conseguem usar o bot.
# WHATSAPP_ALLOWED_NUMBERS=5511999999999,5511888888888

# Opcional: outro número seu que também pode dar comandos /admin por mensagem.
# Na conversa "Você" (consigo mesmo) os comandos já funcionam sem isto.
# NUMERO_DONO=5511888888888

# Fuso dos lembretes e do horário de ausência
FUSO_HORARIO=America/Sao_Paulo

# Espera (ms) para juntar mensagens seguidas numa resposta só; 0 desliga
JUNTAR_MENSAGENS_MS=2500

# true deixa o assistente responder em grupos quando você é mencionado
GRUPOS_ATIVADOS=false

# Gemini
GEMINI_API_KEY=sua_chave_aqui
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_MAX_TOKENS=2048
GEMINI_TIMEOUT=30000
# Opcional: limite de chamadas por dia do seu plano, para o /admin uso mostrar a porcentagem
GEMINI_LIMITE_DIARIO=

# MongoDB
MONGODB_URI=
# Opcional: nome do banco (padrão whatsapp-gemini-bot)
MONGODB_DB_NAME=whatsapp-gemini-bot

# Aplicação
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Lembretes
REMINDER_CHECK_INTERVAL=60000

# Dashboard
DASHBOARD_ENABLED=true
DASHBOARD_AUTH_TOKEN=troque-por-um-token-secreto

# APIs externas opcionais
TOOL_WEATHER_API_KEY=
TOOL_NEWS_API_KEY=
TOOL_EXCHANGE_RATE_API_KEY=
