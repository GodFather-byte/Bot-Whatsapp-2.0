# WhatsApp
# Número em que o bot atende os clientes do Bot PH Zeus (com DDI e DDD)
NUMEROS_BOT=5511991361386
# Deixe comentada para qualquer cliente poder falar com o bot. Atenção: se a variável
# existir (mesmo vazia), só os números listados conseguem usar o bot.
# WHATSAPP_ALLOWED_NUMBERS=5511999999999,5511888888888

# Dono do bot (comandos /admin): WhatsApp da dona do estúdio. Não pode ser o número do bot.
NUMERO_DONO=5511945788032

# Fuso dos lembretes e do horário de atendimento
FUSO_HORARIO=America/Sao_Paulo

# Espera (ms) para juntar mensagens seguidas numa resposta só; 0 desliga
JUNTAR_MENSAGENS_MS=2500

# false faz o bot ignorar grupos
GRUPOS_ATIVADOS=true

# Gemini
GEMINI_API_KEY=sua_chave_aqui
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_TOKENS=2048
GEMINI_TIMEOUT=30000
# Opcional: limite de chamadas por dia do seu plano, para o /admin uso mostrar a porcentagem
GEMINI_LIMITE_DIARIO=

# MongoDB
MONGODB_URI=
# Opcional: nome do banco (padrão whatsapp-gemini-bot)
MONGODB_DB_NAME=whatsapp-gemini-bot

# Aplicação
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Lembretes
REMINDER_CHECK_INTERVAL=60000

# Agenda (agendamentos feitos pela IA). Os dias e horas em que dá para agendar a dona define no WhatsApp:
#   /admin agenda horario seg-sex 09:00-19:00; sab 09:00-14:00
# Intervalo entre horários, em minutos (cada horário atende um cliente; no mínimo 30, a maior sessão)
AGENDA_INTERVALO_MIN=30
# Antecedência mínima para agendar, em minutos
AGENDA_ANTECEDENCIA_MIN=60
# Até quantos dias à frente a agenda aceita agendamentos
AGENDA_DIAS_A_FRENTE=30
# Máximo de agendamentos ativos por cliente
AGENDA_MAX_POR_CLIENTE=2
# Hora (0-23) em que a dona recebe o resumo da agenda do dia; "desligado" para não enviar
AGENDA_RESUMO_HORA=8

# Google Agenda (opcional): cria os agendamentos direto na agenda da dona.
# GOOGLE_CALENDAR_ID é o e-mail da agenda; GOOGLE_SERVICE_ACCOUNT_JSON é o JSON da conta de serviço (puro ou em base64).
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Dashboard
DASHBOARD_ENABLED=true
DASHBOARD_AUTH_TOKEN=troque-por-um-token-secreto

# APIs externas opcionais
TOOL_WEATHER_API_KEY=
TOOL_NEWS_API_KEY=
TOOL_EXCHANGE_RATE_API_KEY=
